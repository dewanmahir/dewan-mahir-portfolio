# ==============================================================================
# Dewan Mahir Portfolio - Environment Configuration
# ==============================================================================

# Primary: Resend Email API (Recommended for Vercel & Serverless)
# 1. Sign up at https://resend.com (Free: 100 emails/day, 3,000/month)
# 2. Create an API Key in the Resend dashboard
# 3. Paste the key below (starts with re_)
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender address:
# - Use 'Dewan Mahir Portfolio <onboarding@resend.dev>' for initial setup (sends to your account email).
# - When you connect a custom domain in Resend, change to e.g. 'Dewan Mahir <hello@yourdomain.com>'
RESEND_FROM_EMAIL=Dewan Mahir Portfolio <onboarding@resend.dev>

# Recipient address where visitor messages are delivered:
EMAIL_TO=dewanmahirofficial@gmail.com

# ------------------------------------------------------------------------------
# Secondary Fallback: Gmail SMTP via Nodemailer
# ------------------------------------------------------------------------------
EMAIL_USER=dewanmahirofficial@gmail.com
EMAIL_PASS=your_16_character_app_password_here

# Port for standalone Express server (npm run server)
PORT=5000
